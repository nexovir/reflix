# --- Python build / packaging artifacts ---
build/
dist/
*.egg-info/
*.egg
__pycache__/
*.pyc
*.pyo

# --- Virtual environment ---
venv/
.venv/
env/

# --- Third-party tool binaries accidentally dropped in the repo ---
httpx
fallparams
nuclei

# --- Reflix runtime output (generated by the tool itself, not source) ---
reflix.output
reflix.out
all_params.txt
logger.txt
*.output
*.log

# --- JSON findings exports (usually target-specific, don't commit) ---
findings.json
*.findings.json

# --- Local test input (often contains real target URLs - don't commit) ---
urls.txt
params.txt
targets.txt

# --- Editor / OS junk ---
.vscode/
.idea/
.DS_Store
*.swp
